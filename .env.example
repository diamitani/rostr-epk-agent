# ============================================================
# ROSTR EPK Agent — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ============================================================

# ------ Vercel AI Gateway ----------------------------------
# Get your gateway key from: https://vercel.com/ai-gateway
VERCEL_AI_GATEWAY_KEY=your_vercel_ai_gateway_key_here

# ------ Anthropic (fallback / direct calls) ----------------
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ------ Model selection ------------------------------------
# Default model routed through AI Gateway
DEFAULT_MODEL=anthropic/claude-sonnet-4-5

# ------ Presenton (AI Presentation Builder) ----------------
# Self-hosted Docker: http://localhost:8080
# Cloud hosted: https://api.presenton.ai
PRESENTON_API_URL=http://localhost:8080
PRESENTON_API_KEY=

# ------ Composio (Platform data connectors) ----------------
COMPOSIO_API_KEY=your_composio_api_key_here

# ------ Canva MCP (Optional — designer-grade rendering) ----
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=

# ------ Vercel Sandbox (Code execution) --------------------
# Automatically available in Vercel runtime, set for local dev
VERCEL_SANDBOX_KEY=

# ------ Storage (EPK artifact persistence) -----------------
# Supabase (recommended) or any S3-compatible
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# S3-compatible alternative
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=

# ------ App Config -----------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
